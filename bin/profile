#!/usr/bin/env bash
# profile - link dotfiles from this repo (and any private overlays) into place.
#
# Every repo (this one, plus each registered overlay) carries a `links` manifest:
#
#   <usecase>  <os>  <source, relative to that repo>  <target, ~/-relative or absolute>
#
# `base` always applies. Other use cases (dev, desktop, host, or anything an
# overlay defines) apply only once enabled on this machine with
# `profile enable <usecase>`. <os> is all, darwin or linux.
#
# Must run under macOS's stock bash 3.2: no associative arrays, no mapfile,
# no ${var,,}.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: profile <command> [args]

  link [--dry-run]        create/repair links for base + enabled use cases (default)
  check                   report drift; exit 1 if anything is missing or wrong
  status                  show use cases, overlays and every link's state
  enable <usecase>...     enable use cases on this machine, then link
  disable <usecase>...    disable use cases and remove their links
  overlay add <dir>       register a private overlay repo, then link
  overlay remove <dir>    unregister an overlay and remove its links
  usecases                list use cases defined by this repo and overlays

Real files are never overwritten: they move to
~/.local/state/profile/backup/<timestamp>/ first.
EOF
}

# ----------------------------------------------------------------- paths ---
resolve() {
  # Portable `readlink -f` (older macOS lacks -f).
  local p="$1" dir
  while [ -L "$p" ]; do
    dir="$(cd "$(dirname "$p")" && pwd -P)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$dir/$p" ;; esac
  done
  echo "$(cd "$(dirname "$p")" && pwd -P)/$(basename "$p")"
}

PROFILE_ROOT="$(dirname "$(dirname "$(resolve "$0")")")"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/profile"
USECASES_FILE="$STATE_DIR/usecases"
OVERLAYS_FILE="$STATE_DIR/overlays"
BACKUP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/profile/backup/$(date +%Y%m%d-%H%M%S)"

case "$(uname -s)" in
  Darwin) OS=darwin ;;
  Linux)  OS=linux ;;
  *) echo "profile: unsupported OS $(uname -s)" >&2; exit 2 ;;
esac

DRY_RUN=0
DRIFT=0
ERRORS=0

say()  { printf '%s\n' "$*"; }
warn() { printf 'profile: %s\n' "$*" >&2; }

# ----------------------------------------------------------------- state ---
enabled_usecases() {
  echo base
  [ -f "$USECASES_FILE" ] && grep -v '^[[:space:]]*$' "$USECASES_FILE" | grep -vx base || true
}

repos() {
  echo "$PROFILE_ROOT"
  if [ -f "$OVERLAYS_FILE" ]; then
    local d
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      if [ -f "$d/links" ]; then echo "$d"; else warn "overlay $d has no links manifest - skipped"; fi
    done < "$OVERLAYS_FILE"
  fi
}

is_enabled() { enabled_usecases | grep -qx "$1"; }

# Emit "<usecase> <abs source> <abs target>" for every manifest line that
# applies to this OS, regardless of whether the use case is enabled.
manifest() {
  local repo uc os src target
  repos | while IFS= read -r repo; do
    # shellcheck disable=SC2034
    while read -r uc os src target rest; do
      case "$uc" in ''|\#*) continue ;; esac
      if [ -z "$target" ]; then warn "$repo/links: malformed line: $uc $os $src"; continue; fi
      [ "$os" = all ] || [ "$os" = "$OS" ] || continue
      case "$target" in "~/"*) target="$HOME/${target#\~/}" ;; esac
      echo "$uc $repo/$src $target"
    done < "$repo/links"
  done
}

# ----------------------------------------------------------------- links ---
backup() {
  local target="$1" rel dest
  case "$target" in
    "$HOME"/*) rel="${target#"$HOME"/}" ;;
    *)         rel="root${target}" ;;
  esac
  dest="$BACKUP_DIR/$rel"
  mkdir -p "$(dirname "$dest")"
  mv "$target" "$dest"
  say "  backed up $target -> $dest"
}

link_one() {
  local src="$1" target="$2"
  if [ ! -e "$src" ]; then
    warn "missing source $src"; ERRORS=$((ERRORS + 1)); return
  fi
  # ssh refuses a group/world-writable config, and a umask of 002 checks files
  # out that way. Done on every run, so re-linking also repairs a correct link.
  if [ "$DRY_RUN" != 1 ]; then chmod go-w "$src"; fi
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
    return
  fi
  if [ -d "$target" ] && [ ! -L "$target" ]; then
    warn "$target is a real directory - refusing to replace it"; ERRORS=$((ERRORS + 1)); return
  fi
  if [ "$DRY_RUN" = 1 ]; then
    if [ -e "$target" ] || [ -L "$target" ]; then
      say "  would back up $target and link -> $src"
    else
      say "  would link $target -> $src"
    fi
    return
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then backup "$target"; fi
  mkdir -p "$(dirname "$target")"
  ln -s "$src" "$target"
  say "  linked $target -> $src"
}

unlink_one() {
  local src="$1" target="$2"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
    if [ "$DRY_RUN" = 1 ]; then say "  would remove link $target"; return; fi
    rm "$target"
    say "  removed link $target"
  fi
}

link_state() {
  local src="$1" target="$2"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then echo ok
  elif [ -L "$target" ]; then echo "wrong-link"
  elif [ -e "$target" ]; then echo "real-file"
  else echo missing
  fi
}

set_hooks() {
  local repo
  repos | while IFS= read -r repo; do
    [ -d "$repo/.githooks" ] && [ -d "$repo/.git" ] || continue
    if [ "$(git -C "$repo" config --local --get core.hooksPath 2>/dev/null || true)" != .githooks ]; then
      if [ "$DRY_RUN" = 1 ]; then say "  would set core.hooksPath=.githooks in $repo"; continue; fi
      git -C "$repo" config --local core.hooksPath .githooks
      say "  set core.hooksPath=.githooks in $repo"
    fi
  done
}

# Two links claiming the same target would flap on every run.
check_conflicts() {
  local dups
  # `if`, not `&&`: under pipefail a loop whose last test was false fails the pipe.
  dups="$(manifest | while read -r uc src target; do
    if is_enabled "$uc"; then echo "$target"; fi
  done | sort | uniq -d)"
  if [ -n "$dups" ]; then
    warn "more than one enabled manifest line targets: $dups"
    exit 1
  fi
}

# -------------------------------------------------------------- commands ---
cmd_link() {
  if [ "${1:-}" = --dry-run ]; then DRY_RUN=1; fi
  check_conflicts
  # Process substitution rather than a pipe, so ERRORS survives the loop.
  while read -r uc src target; do
    is_enabled "$uc" || continue
    link_one "$src" "$target"
  done < <(manifest)
  set_hooks
  if [ "$ERRORS" -gt 0 ]; then warn "$ERRORS error(s)"; exit 1; fi
}

cmd_check() {
  local state
  while read -r uc src target; do
    is_enabled "$uc" || continue
    state="$(link_state "$src" "$target")"
    if [ "$state" != ok ]; then
      say "$state: $target (want -> $src)"
      DRIFT=$((DRIFT + 1))
    fi
  done < <(manifest)
  if [ "$DRIFT" -gt 0 ]; then say "$DRIFT link(s) drifted - run: profile link"; exit 1; fi
  say "all links ok"
}

cmd_status() {
  say "repo:      $PROFILE_ROOT"
  say "os:        $OS"
  say "use cases: $(enabled_usecases | tr '\n' ' ')"
  say "overlays:  $(repos | tail -n +2 | tr '\n' ' ')"
  say ""
  local mark shown
  while read -r uc src target; do
    if is_enabled "$uc"; then mark="$(link_state "$src" "$target")"; else mark="(disabled)"; fi
    case "$target" in "$HOME"/*) shown="~/${target#"$HOME"/}" ;; *) shown="$target" ;; esac
    printf '  %-10s %-11s %s\n' "$uc" "$mark" "$shown"
  done < <(manifest)
}

# A use case exists if a manifest names it or a repo has zsh/<usecase>/.
cmd_usecases() {
  {
    manifest | awk '{print $1}'
    repos | while IFS= read -r repo; do
      for d in "$repo"/zsh/*/; do
        if [ -d "$d" ]; then basename "$d"; fi
      done
    done
  } | sort -u
}

known_usecase() { cmd_usecases | grep -qx "$1"; }

cmd_enable() {
  [ $# -gt 0 ] || { usage; exit 2; }
  mkdir -p "$STATE_DIR"
  local uc
  for uc in "$@"; do
    known_usecase "$uc" || { warn "unknown use case: $uc (see: profile usecases)"; exit 2; }
    [ "$uc" = base ] && continue
    is_enabled "$uc" || echo "$uc" >> "$USECASES_FILE"
  done
  cmd_link
}

cmd_disable() {
  [ $# -gt 0 ] || { usage; exit 2; }
  local uc tmp
  for uc in "$@"; do
    [ "$uc" = base ] && { warn "base cannot be disabled"; exit 2; }
    while read -r luc src target; do
      if [ "$luc" = "$uc" ]; then unlink_one "$src" "$target"; fi
    done < <(manifest)
    if [ -f "$USECASES_FILE" ]; then
      tmp="$(mktemp)"
      grep -vx "$uc" "$USECASES_FILE" > "$tmp" || true
      mv "$tmp" "$USECASES_FILE"
    fi
  done
  say "backups of files replaced earlier are under ${BACKUP_DIR%/*}/"
}

cmd_overlay() {
  local action="${1:-}" dir="${2:-}" tmp
  [ -n "$dir" ] || { usage; exit 2; }
  case "$action" in
    add)
      dir="$(cd "$dir" && pwd -P)"
      [ -f "$dir/links" ] || { warn "$dir has no links manifest"; exit 2; }
      mkdir -p "$STATE_DIR"
      grep -qx "$dir" "$OVERLAYS_FILE" 2>/dev/null || echo "$dir" >> "$OVERLAYS_FILE"
      cmd_link
      ;;
    remove)
      dir="$(cd "$dir" 2>/dev/null && pwd -P || echo "$dir")"
      while read -r uc src target; do
        case "$src" in "$dir"/*) unlink_one "$src" "$target" ;; esac
      done < <(manifest)
      if [ -f "$OVERLAYS_FILE" ]; then
        tmp="$(mktemp)"
        grep -vx "$dir" "$OVERLAYS_FILE" > "$tmp" || true
        mv "$tmp" "$OVERLAYS_FILE"
      fi
      ;;
    *) usage; exit 2 ;;
  esac
}

cmd="${1:-link}"
[ $# -gt 0 ] && shift
case "$cmd" in
  link)     cmd_link "$@" ;;
  check)    cmd_check ;;
  status)   cmd_status ;;
  enable)   cmd_enable "$@" ;;
  disable)  cmd_disable "$@" ;;
  overlay)  cmd_overlay "$@" ;;
  usecases) cmd_usecases ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
